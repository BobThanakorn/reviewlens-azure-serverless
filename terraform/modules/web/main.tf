terraform {
  required_version = ">= 1.10"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = ">= 5.0, < 6.0"
    }
    local = {
      source  = "hashicorp/local"
      version = ">= 2.0, < 3.0"
    }
  }
}

# Static website account. It is the only account with anonymous read, and only the $web container
# that the static website feature creates; shared keys stay disabled and uploads use Entra auth.
resource "azurerm_storage_account" "web" {
  #checkov:skip=CKV_AZURE_59:Public network access stays on: Functions and GitHub runners have no VNet; writes need Entra auth and shared keys are disabled; only the static $web content is anonymously readable
  #checkov:skip=CKV_AZURE_33:Queue request logging needs diagnostic settings and log ingestion cost; listed under production next steps
  #checkov:skip=CKV_AZURE_206:LRS is enough for a re-creatable dev environment; geo-replication would double storage cost
  #checkov:skip=CKV2_AZURE_1:Microsoft-managed keys are acceptable here; customer-managed keys need Key Vault, listed under production next steps
  #checkov:skip=CKV2_AZURE_33:Private endpoints add always-on hourly cost, which this project forbids
  #checkov:skip=CKV_AZURE_190:Anonymous read is required to serve the public static dashboard; only the $web container is exposed
  #checkov:skip=CKV2_AZURE_47:Anonymous read is required to serve the public static dashboard; only the $web container is exposed
  name                = var.account_name
  resource_group_name = var.resource_group_name
  location            = var.location

  account_tier             = "Standard"
  account_replication_type = "LRS"
  min_tls_version          = "TLS1_2"

  https_traffic_only_enabled      = true
  allow_nested_items_to_be_public = true
  shared_access_key_enabled       = false
  default_to_oauth_authentication = true

  blob_properties {
    delete_retention_policy {
      days = 7
    }

    container_delete_retention_policy {
      days = 7
    }
  }

  tags = var.tags
}

resource "azurerm_storage_account_static_website" "web" {
  storage_account_id = azurerm_storage_account.web.id
  index_document     = "index.html"
  error_404_document = "index.html"
}

# Generated at apply time so the dashboard never hard-codes the API URL. Git-ignored; the
# deploy step uploads the whole web/ folder, including this file.
resource "local_file" "config_js" {
  filename        = var.config_js_path
  file_permission = "0644"
  content         = <<-EOT
    // Generated by Terraform (modules/web). Do not edit.
    window.REVIEWLENS_CONFIG = { apiBaseUrl: "${var.api_base_url}" };
  EOT
}
